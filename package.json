{
    "name": "promoping",
    "version": "2.3.3",
    "type": "module",
    "description": "Projeto PromoPing - Backend + Frontend",
    "main": "backend/server.js",
    "scripts": {
        "start": "node backend/discord-bot/run.js",
        "dev": "nodemon backend/server.js",
        "run": "node backend/discord-bot/run.js",
        "release": "node scripts/release.js",
        "setup": "node scripts/setup.js",
        "check": "node scripts/check-deps.js",
        "migrate": "node scripts/migrate-db.js",
        "docker:dev": "docker-compose -f docker-files/docker-compose.dev.yml up --build",
        "docker:prod": "docker-compose -f docker-files/docker-compose.yml up --build",
        "db:init": "mysql -u root -p < sql/PAPv5.sql",
        "db:migrate": "npm run migrate",
        "db:reset": "mysql -u root -p -e 'DROP DATABASE IF EXISTS pap; CREATE DATABASE pap;' && npm run db:init && npm run db:migrate",
        "install:all": "npm install && npm run setup && npm run db:migrate",
        "quick-start": "npm run setup && npm run db:migrate && npm run dev",
        "discord:start": "cd backend/discord-bot && npm start",
        "discord:dev": "cd backend/discord-bot && npm run dev",
        "discord:test": "cd backend/discord-bot && npm test",
        "prepare:frontend": "node scripts/prepare-frontend-production.js",
        "create-admin": "node scripts/create-admin-user.js",
        "test": "echo \"Error: no test specified\" && exit 1"
    },
    "keywords": [],
    "author": "Julia Rebouças Leite",
    "license": "GPL-2.0",
    "dependencies": {
        "@discordjs/opus": "^0.10.0",
        "@discordjs/voice": "^0.19.0",
        "@distube/ytdl-core": "^4.16.12",
        "axios": "^1.12.2",
        "bcrypt": "^6.0.0",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "discord-rpc": "^4.0.1",
        "discord.js": "^14.22.1",
        "dotenv": "^17.2.3",
        "exceljs": "^4.4.0",
        "express": "^5.1.0",
        "express-rate-limit": "^8.1.0",
        "googleapis": "^169.0.0",
        "jsonwebtoken": "^9.0.2",
        "mysql2": "^3.15.3",
        "node-fetch": "^3.3.2",
        "nodemailer": "^7.0.6",
        "passport": "^0.7.0",
        "passport-discord": "^0.1.4",
        "passport-github2": "^0.1.12",
        "passport-google-oauth20": "^2.0.0",
        "pdfkit": "^0.17.2",
        "stripe": "^19.0.0",
        "twilio": "^5.10.1",
        "ytpl": "^2.3.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.2",
        "eslint": "^9.39.2",
        "nodemon": "^3.1.0"
    }
}
