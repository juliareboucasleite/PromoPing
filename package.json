{
    "name": "promoping",
    "version": "2.3.3",
    "type": "module",
    "description": "Projeto PromoPing - Backend + Frontend",
    "main": "backend/server.js",
    "scripts": {
        "start": "node backend/server.js",
        "dev": "nodemon backend/server.js",
        "run": "node backend/server.js",
        "bot:start": "node backend/discord-bot/index.js",
        "pm2:start": "pm2 start ecosystem.config.cjs --update-env",
        "pm2:reload": "pm2 reload ecosystem.config.cjs --update-env",
        "release": "node scripts/release.js",
        "setup": "node scripts/setup-postgres.js",
        "check": "node scripts/check-deps.js",
        "migrate": "node scripts/migrate-db-postgres.js",
        "docker:dev": "docker-compose -f docker-files/docker-compose.dev.yml up --build",
        "docker:prod": "docker-compose -f docker-files/docker-compose.yml up --build",
        "nginx:start": "node scripts/nginx-start.js",
        "nginx:stop": "docker compose -f docker-files/docker-compose.nginx.yml down",
        "db:init": "node scripts/build-postgres-init.js && psql -U postgres -d papv5 -f sql/PAPv5.postgres.sql",
        "db:migrate": "npm run migrate",
        "db:ensure-tables": "node scripts/ensure-qr-tokens-table.js",
        "db:reset": "psql -U postgres -c \"DROP DATABASE IF EXISTS papv5;\" && psql -U postgres -c \"CREATE DATABASE papv5;\" && npm run db:init && npm run db:migrate",
        "install:all": "npm install && npm run setup && npm run db:migrate",
        "quick-start": "npm run setup && npm run db:migrate && npm run dev",
        "discord:start": "cd backend/discord-bot && npm start",
        "discord:dev": "cd backend/discord-bot && npm run dev",
        "discord:test": "cd backend/discord-bot && npm test",
        "prepare:frontend": "node scripts/prepare-frontend-production.js",
        "create-admin": "node scripts/create-admin-user.js",
        "test": "echo \"Error: no test specified\" && exit 1"
    },
    "keywords": [],
    "author": "Julia Rebouças Leite",
    "license": "GPL-2.0",
    "dependencies": {
        "@tailwindcss/vite": "^4.2.4",
        "bcrypt": "^6.0.0",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.6",
        "discord-interactions": "^4.4.0",
        "discord-rpc": "^4.0.1",
        "discord.js": "^14.25.1",
        "dotenv": "^17.2.3",
        "exceljs": "^4.4.0",
        "express": "^5.2.1",
        "express-rate-limit": "^8.1.0",
        "express-validator": "^7.3.1",
        "googleapis": "^169.0.0",
        "jsonwebtoken": "^9.0.2",
        "node-fetch": "^3.3.2",
        "nodemailer": "^7.0.13",
        "openai": "^6.17.0",
        "passport": "^0.7.0",
        "passport-discord": "^0.1.4",
        "passport-github2": "^0.1.12",
        "passport-google-oauth20": "^2.0.0",
        "pdfkit": "^0.17.2",
        "pg": "^8.20.0",
        "psql": "^0.0.1",
        "qrcode": "^1.5.4",
        "speakeasy": "^2.0.0",
        "stripe": "^19.0.0",
        "tailwindcss": "^4.2.4",
        "uuid": "^13.0.0",
        "winston": "^3.19.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.2",
        "eslint": "^9.39.2",
        "nodemon": "^3.1.0"
    }
}
