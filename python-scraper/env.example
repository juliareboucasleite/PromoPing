# ===== DATABASE =====
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=pap
DB_PORT=3306

# ===== SCRAPER CONFIG =====
# Tempo em segundos entre cada ciclo de verificação
CYCLE_INTERVAL=120

# Define se o Chrome roda oculto (headless)
# False = mostra o navegador (recomendado para Amazon)
# True = roda em segundo plano (pode causar bloqueio na Amazon)
HEADLESS=False

# Tempo máximo de espera para elementos (segundos)
MAX_WAIT=10

# User Agent para requests
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36

# ===== LOGGING =====
LOG_LEVEL=INFO
LOG_FILE=scraper.log
LOG_MAX_SIZE=10485760
LOG_BACKUP_COUNT=5

# ===== NOTIFICATIONS =====
# Habilitar notificações
NOTIFICATION_ENABLED=false

# Webhook URL para notificações (Discord, Slack, etc.)
NOTIFICATION_WEBHOOK_URL=

# Configurações de email (opcional)
EMAIL_ENABLED=false
EMAIL_SMTP=
EMAIL_USER=
EMAIL_PASSWORD=
